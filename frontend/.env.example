# Privy 
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
NEXT_PUBLIC_PRIVY_CLIENT_ID= # optional, you can leave this empty

# Web Push
WEB_PUSH_EMAIL=user@example.com
WEB_PUSH_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=your_vapid_public_key


# Backend API (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8420

# Deployed DebtPots.sol address on Monad testnet (enables the payday sweep screen)
NEXT_PUBLIC_DEBTPOTS_ADDRESS=
# How much testnet MON represents GBP1 in the demo
NEXT_PUBLIC_MON_PER_GBP=0.001
