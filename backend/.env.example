# KIMI (Moonshot AI) - powers /draft-appeal's LLM drafting.
# Get a key at https://platform.moonshot.ai
# Without this set, /draft-appeal falls back to a deterministic template
# (still fully demoable, just not LLM-generated prose).
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2-0711-preview

# Alchemy - powers POST /webhooks/alchemy (Address Activity notifications for
# "payday deposit landed" push notifications). Create an app on "Monad
# Testnet" at https://dashboard.alchemy.com, then create a webhook under
# Notify > Address Activity watching your deployed DebtPots address, and
# copy its signing key here. Without this set, the endpoint returns 503.
ALCHEMY_WEBHOOK_SIGNING_KEY=
# Same dashboard app's API key - also used by contracts/foundry.toml's
# alchemy_monad_testnet RPC endpoint alias.
ALCHEMY_API_KEY=
